# ── FINCH environment ─────────────────────────────────────────────────────
# Copy to .env.local (web app) or your runtime environment. Never commit
# real values. "public" vars are inlined into the browser bundle; everything
# else is server/runtime only.

# ── Model compute (server) — set ANY ONE of these ────────────────────────
# Finch picks automatically and PREFERS FREE TIERS, so a public deployment
# costs nothing per visitor. Without any of them, previews refuse rather than
# fabricate a response.
#
# Free tiers (pick one; Groq is the fastest to set up):
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
#
# Fully free and local — no key, no quota. Install Ollama, then:
# ENABLE_OLLAMA=1
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2
#
# Paid providers (used only if no free one is configured):
HYPERBOLIC_API_KEY=
TOGETHER_API_KEY=
#
# Force a specific provider regardless of preference order:
# FINCH_PROVIDER=groq
# Override the model for a provider (catalogs change; these are just defaults):
# GROQ_MODEL=llama-3.3-70b-versatile

# Data layer (server) — least-privilege user, readWrite on the finch db only.
# Optional: without it, the site serves labeled seed data read-only.
MONGODB_URI=
MONGODB_DB=finch

# ── Robinhood Chain (public) — official mainnet params are BAKED IN ──────
# chain 4663 · https://rpc.mainnet.chain.robinhood.com ·
# https://explorer.mainnet.chain.robinhood.com (Blockscout). These vars are
# OVERRIDES only (e.g. a dedicated RPC provider in production):
# NEXT_PUBLIC_ROBINHOOD_RPC_URL=
# NEXT_PUBLIC_ROBINHOOD_EXPLORER_URL=
# NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=4663
# NEXT_PUBLIC_ROBINHOOD_CHAIN_NAME=Robinhood Chain

# Fork/dev testing (server): target Arbitrum Sepolia instead of mainnet
# FLIGHTPATH_FORCE_DEV=1
FLIGHTPATH_DEV_RPC_URL=

# ── Finch fee wallet ─────────────────────────────────────────────────────
# The creator-fee recipient for the $FINCH Pons launch (3% creator tax).
# Address (server, display + launch-guard checks):
FINCH_FEE_WALLET_ADDRESS=
# PRIVATE KEY — trusted server infrastructure ONLY. Never client JS, never
# NEXT_PUBLIC_*, never git, never MongoDB, never logs, never API responses.
# The only code allowed to read it is apps/web/src/server/wallet.ts.
# FINCH_FEE_WALLET_PRIVATE_KEY=

# FinchRegistry (server) — the onchain identity layer. Until this is set, the
# app reports every listing as unregistered rather than implying otherwise.
FINCH_REGISTRY_ADDRESS=

# Optional onchain FeeVault (fee receiver contract that can only sweep to the
# fee wallet; makes revenue trivially indexable):
FINCH_FEE_VAULT_ADDRESS=

# OperatorBudget contract (bounded automation float), once deployed:
FINCH_OPERATOR_BUDGET_ADDRESS=

# ── Operator runtime ONLY (never the web app, never committed) ───────────
# Restricted agent-operator wallet key, bounded by OperatorBudget + policy.
# FLIGHTPATH_OPERATOR_KEY=

# Pons integration (server) — once Pons publishes contracts. The launch guard
# blocks $FINCH launch signing until version/tax/recipient verify onchain.
PONS_FACTORY_ADDRESS=

# Approved RWA registry (server) — JSON array
# RWA_APPROVED_ASSETS=[{"address":"0x…","symbol":"TBILL","name":"…","kind":"treasury-bill","issuer":"…"}]
