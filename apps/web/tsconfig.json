{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    "verbatimModuleSyntax": false,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@finch/sdk": ["../../packages/sdk/src/index.ts"],
      "@finch/providers": ["../../packages/providers/src/index.ts"],
      "@finch/flightpath": ["../../packages/flightpath/src/index.ts"],
      "@finch/db": ["../../packages/db/src/index.ts"],
      "@finch/db/seeds": ["../../packages/db/src/seeds.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
