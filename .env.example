# ── FINCH environment ─────────────────────────────────────────────────────
# Copy to .env.local (web app) or your runtime environment. Never commit
# real values. "public" vars are inlined into the browser bundle; everything
# else is server/runtime only.

# ── Model compute (server) — set ANY ONE of these ────────────────────────
# Finch picks automatically and PREFERS FREE TIERS, so a public deployment
# costs nothing per visitor. Without any of them, previews refuse rather than
# fabricate a response.
#
# Free tiers (pick one; Groq is the fastest to set up):
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
#
# Fully free and local — no key, no quota. Install Ollama, then:
# ENABLE_OLLAMA=1
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2
#
# Paid providers (used only if no free one is configured):
HYPERBOLIC_API_KEY=
TOGETHER_API_KEY=
#
# Force a specific provider regardless of preference order:
# FINCH_PROVIDER=groq
# Override the model for a provider (catalogs change; these are just defaults):
# GROQ_MODEL=llama-3.3-70b-versatile

# Data layer (server) — least-privilege user, readWrite on the finch db only.
# Optional: without it, the site serves labeled seed data read-only.
MONGODB_URI=
MONGODB_DB=finch

# ── Solana (server) ──────────────────────────────────────────────────────
# Cluster: mainnet-beta (default), devnet or testnet.
SOLANA_CLUSTER=mainnet-beta
# RPC endpoints, comma-separated, tried in order (failover). The public
# mainnet endpoint is baked in as the fallback, but it is rate limited and
# refuses some methods — production should list a dedicated provider here.
SOLANA_RPC_URLS=
# A single endpoint instead of a list:
# SOLANA_RPC_URL=
# Explorer used for links (default https://solscan.io):
# SOLANA_EXPLORER_URL=https://solscan.io

# Dev testing (server): target devnet instead of mainnet, optionally through
# your own devnet endpoint.
# FLIGHTPATH_FORCE_DEV=1
FLIGHTPATH_DEV_RPC_URL=

# ── Solana (public) ──────────────────────────────────────────────────────
# Which cluster the browser asks wallets to use. Keep it equal to
# SOLANA_CLUSTER. No client RPC is needed: the server builds unsigned
# transactions and the visitor's wallet sends them.
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
# NEXT_PUBLIC_SOLANA_EXPLORER_URL=https://solscan.io

# ── Market data (server) ─────────────────────────────────────────────────
# Jupiter prices, token metadata and swap quotes. The keyless endpoint works;
# a key raises the rate limit and is sent as x-api-key.
# JUPITER_API_URL=https://lite-api.jup.ag
JUPITER_API_KEY=

# ── Solana key format ────────────────────────────────────────────────────
# Every *_KEY below is a Solana secret key: either base58 (the 64-byte secret,
# 87-88 characters) or a JSON array of 64 numbers, as `solana-keygen` writes
# it. Keys live in .env.local or the runtime's secret store — never in
# NEXT_PUBLIC_*, never in git, never in logs or API responses.

# ── $FINCH (server) ──────────────────────────────────────────────────────
# Optional. $FINCH launches on pump.fun; its mint address,
# 63GtvVxFKgXCcSAXXkrPtp7vk8oWyEfqwwdB8gNYpump, is the baked-in default.
# Set this only to point at a different mint. Until a mint account exists at
# the address, every surface reports $FINCH as not launched. Once one does,
# the site reads the mint account, the pump.fun bonding curve (launch phase),
# Jupiter (price, holder count) and DexScreener (markets) live.
# FINCH_TOKEN_MINT=

# Publishing gate (server). Publishing is OPEN AND FREE by default: anyone
# signs for a publisher key with a wallet (POST /api/keys) and lists finches
# and nests. PUBLISH_GATE=hold switches on the $FINCH gate — a publisher must
# then HOLD at least PUBLISH_COST_FINCH of $FINCH, read live at publish
# time. The switch is explicit; the token existing changes nothing.
# Reading, running and composing are always free.
PUBLISH_GATE=open
PUBLISH_COST_FINCH=250000

# ── Registry (server) ────────────────────────────────────────────────────
# The Solana address whose signed memo transactions are the registry. A
# listing counts as anchored only when this address signed its memo. Until it
# is set, the app reports every listing as not anchored rather than implying
# otherwise.
FINCH_REGISTRY_AUTHORITY=
# Its secret key. .env.local ONLY — used by scripts/registry-anchor.mjs and
# nothing else; never set it on the deployment.
# FINCH_REGISTRY_AUTHORITY_KEY=

# ── Finch fee wallet ─────────────────────────────────────────────────────
# Address (server, display only):
FINCH_FEE_WALLET_ADDRESS=
# SECRET KEY — trusted server infrastructure ONLY. Never client JS, never
# NEXT_PUBLIC_*, never git, never MongoDB, never logs, never API responses.
# The only code allowed to read it is apps/web/src/server/wallet.ts. Nothing
# moves funds automatically; holding the key authorizes nothing by itself.
# FINCH_FEE_WALLET_PRIVATE_KEY=

# ── Operator runtime ONLY (never the web app, never committed) ───────────
# Restricted agent-operator keypair, funded with a small float and bounded by
# the policy engine (allowances, program and recipient allowlists).
# FLIGHTPATH_OPERATOR_KEY=

# Approved RWA registry (server) — JSON array; `address` is the SPL mint.
# RWA_APPROVED_ASSETS=[{"address":"<mint>","symbol":"TBILL","name":"…","kind":"treasury-bill","issuer":"…"}]
