{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "echo 'services only - no frontend build needed'"
  },
  "deploy": {
    "startCommand": "node scripts/run-services.mjs",
    "restartPolicyType": "ALWAYS",
    "restartPolicyMaxRetries": 100
  }
}
