# dependencies
node_modules/

# next.js
.next/
out/
next-env.d.ts

# builds — note: no bare "build/" pattern here; Tailwind v4 respects
# .gitignore and it would exclude src/components/build + app/build from
# class detection
dist/

# env — never commit secrets
.env
.env.local
.env.*.local

# foundry
contracts/cache/
contracts/out/
contracts/broadcast/

# misc
.DS_Store
*.log
*.tsbuildinfo

audit-findings.txt
.vercel

# Order matters: a later pattern beats an earlier negation, so `!.env.example`
# MUST be the last env rule. A duplicate `.env*` below it silently un-tracks
# the template.
.env*
!.env.example
